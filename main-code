void Auto4(){//grand部分を後ろにいかせる
  //メーターが上限に達したら
  if(digitalRead(POTENTIOMLGraund_PIN) == HIGH|| analogRead(POTENTIOMLGraund_PIN) >= 500){ 
  //if(digitalRead(POTENTIOMHGraund_PIN) || analogRead(POTENTIOMHGraund_PIN) >= 4000){ 
