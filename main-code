void setup() {
  Serial.begin(115200);
  myServoB.attach(SERVOb_PIN);
  myServoarm.attach(SERVOarm_PIN);
  myServoG.attach(SERVOg_PIN);
  myServoH.attach(SERVOh_PIN);
  pinMode(POTENTIOMLArm_PIN,INPUT);
  pinMode(POTENTIOMHArm_PIN,INPUT);
  pinMode(POTENTIOMLGraund_PIN,INPUT);
  pinMode(POTENTIOMHGraund_PIN,INPUT);
  pinMode(L_PIN,INPUT);
  pinMode(R_PIN,INPUT);
  pinMode(U_PIN,INPUT);
  pinMode(D_PIN,INPUT);
  pinMode(P_PIN,INPUT);
  pinMode(BUTTON_PIN,INPUT);
}


int HIGHNumG = 0;
void Auto1(){//grandサーボで前に行く

  if(digitalRead(POTENTIOMHGraund_PIN) == LOW){

    HIGHNumG--;
    myServoG.write(80); // forward
    
    if(HIGHNumG <=0){HIGHNumG = 0;}
  
  }else{
    HIGHNumG ++;
    if(HIGHNumG >= 10){HIGHNumG =0; state = auto2;}
  }
  
}

void Auto2(){//hand部分を回転させつかむ
  sliderValueHN+=0.02;
  if(sliderValueHN <= 180){
    myServoH.write(sliderValueHN); // forward;
  }
  else{
    delay(1000);
    state = auto3;
  }
}

