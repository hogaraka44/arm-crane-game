int HIGHNumG = 0;
void Auto1(){//grandサーボで前に行く
  //Serial.println("Auto1");//確認済み

  //Serial.print("HIGHNumG");Serial.println(HIGHNumG);//安定


  if(digitalRead(BUTTON_PIN) == LOW){

    HIGHNumG ++;
    if(HIGHNumG >= 10){HIGHNumG =0; state = auto2;
    }
  
  }else{

    HIGHNumG--;
    myServoG.write(85); // forward
    //デバック用
    //delay(1000);
    //myServoG.write(120); // forward
    //delay(1000);
    //Serial.println(" myServoG.write(80)");
    //デバック用ここまで
    if(HIGHNumG <=0){HIGHNumG = 0;}
  }
  
}

void Auto2(){//hand部分を回転させつかむ
  //Serial.println(sliderValueHN);//確認済み
  sliderValueHN+=0.04;
  Serial.println(sliderValueHN);//確認済み
  if(sliderValueHN <= 180){
    myServoH.write(sliderValueHN); // forward;
  }
  else{
    state = auto3;
  }
}

void Auto3(){//grand部分を後ろにいかせる
  //メーターが上限に達したら
  if(digitalRead(POTENTIOMLGraund_PIN) == HIGH){ 
    state = auto4;//安定動作
  }

  else{
     myServoG.write(120); //back;
  }
}

void Auto4(){//根本部分を景品の方に回転させる
  Serial.print("auto4 ");
  Serial.println(sliderValueBN);

  if(sliderValueBN <= 150){
    sliderValueBN += 0.02;
     myServoB.write(sliderValueBN); // forward;
  }
  else{
    state = auto5;
  }
}

void Auto5(){//hand部分を回転させはなす
  Serial.print("auto5 ");
  //Serial.println(sliderValueHN);
  sliderValueHN-=0.02;

  if(0 <= sliderValueHN){
    myServoH.write(sliderValueHN); //はなす
  }
  else{
    state = set1;
  }

}

void Set1(){

   if(sliderValueHN >= 0){
    sliderValueHN = -0.02;
    myServoH.write(sliderValueHN);
  }

  if(sliderValueBN >= 45){
    sliderValueBN -= 0.02;
     myServoB.write(sliderValueBN); // forward;
  }
  else{
    state = contA;
  }

}

 
