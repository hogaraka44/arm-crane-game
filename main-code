    myServoG.write(90); //back;
    delay(1000);
  }

  else{
     myServoG.write(100); //back;
  }
}

void Auto5(){//根本部分を景品の方に回転させる

  if(sliderValueBN <= 151){
    sliderValueBN += 0.05;
     myServoB.write(sliderValueBN); // forward;
     delay(10);
  }
  if(sliderValueBN >= 149){
    delay(2000);
    state = auto6;
  }
}

unsigned long time0 =0;
unsigned long time1 =0;


void Auto6(){//hand部分を回転させはなす

  sliderValueHN-=0.05;

    myServoH.write(0); //はなす
    delay(2000);
    state = set1;
    time0 = millis();

}

void Set1(){

  myServoG.write(90); // stop88と87の間
  time1 = millis();
  if(sliderValueHN >= 0){
    sliderValueHN = -0.1;
    myServoH.write(sliderValueHN);
  }

  else if(sliderValueBN >= 45){
    sliderValueBN += 0.05;
     delay(10);
     myServoB.write(sliderValueBN); // forward;
  }

  else if(sliderValueBN >= 45){
    sliderValueBN -= 0.02;
     myServoB.write(sliderValueBN); // forward;
  }

  else{
    state = contA;
  }

  if(time1-time0 > 10000){
    state = contA;
  }

}

 
